---
import { getCollection, getEntries, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { byRecency } from '../../lib/publications';
import Publication from '../../components/Publication.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const pubs = (await getEntries(project.data.publications)).sort(byRecency);
---

<Base title={project.data.title} description={project.data.summary}>
  <header class="page-header">
    <p class="sans small"><a href="/research/">← Research</a></p>
    <h1>{project.data.title}</h1>
    <p>{project.data.summary}</p>
    {project.data.links.length > 0 && (
      <div class="link-row">{project.data.links.map((l) => <a href={l.href}>{l.label}</a>)}</div>
    )}
  </header>
  <article class="prose"><Content /></article>

  {pubs.length > 0 && (
    <>
      <h2 class="section-title">Publications</h2>
      <ul class="plain-list">{pubs.map((pub) => <Publication pub={pub} />)}</ul>
    </>
  )}
</Base>
