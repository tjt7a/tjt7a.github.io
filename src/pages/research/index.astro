---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const groups = [
  { label: 'Current projects', items: projects.filter((p) => p.data.status === 'active') },
  { label: 'Past projects', items: projects.filter((p) => p.data.status === 'past') },
];
---

<Base title="Research" description="Research projects">
  <header class="page-header">
    <h1>Research</h1>
  </header>

  {groups.filter((g) => g.items.length).map((g) => (
    <>
      <h2 class="section-title">{g.label}</h2>
      <ul class="plain-list">
        {g.items.map((p) => (
          <li class="project">
            <a class="project-title" href={`/research/${p.id}/`}>{p.data.title}</a>
            <p>{p.data.summary}</p>
          </li>
        ))}
      </ul>
    </>
  ))}
</Base>

<style>
  .project { margin-bottom: 1.5rem; }
  .project-title { font-family: var(--sans); font-weight: 600; font-size: 1.1rem; }
  .project p { margin: 0.25rem 0 0; }
</style>
