---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { byRecency } from '../lib/publications';
import Publication from '../components/Publication.astro';
import { site } from '../site.config';

const pubs = (await getCollection('publications')).sort(byRecency);
const years = [...new Set(pubs.map((p) => p.data.year))];
const scholar = site.links.find((l) => l.label === 'Google Scholar');
---

<Base title="Publications" description={`Publications by ${site.name}`}>
  <header class="page-header">
    <h1>Publications</h1>
    {scholar && <p class="sans small">Also on <a href={scholar.href}>Google Scholar</a>.</p>}
  </header>

  {years.map((year) => (
    <>
      <h2 class="section-title">{year}</h2>
      <ul class="plain-list">
        {pubs.filter((p) => p.data.year === year).map((pub) => <Publication pub={pub} />)}
      </ul>
    </>
  ))}
</Base>
