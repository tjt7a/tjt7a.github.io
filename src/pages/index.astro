---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { byRecency } from '../lib/publications';
import Publication from '../components/Publication.astro';
import NoteList from '../components/NoteList.astro';
import { site } from '../site.config';
import { getNotes } from '../lib/wiki';

const selected = (await getCollection('publications', ({ data }) => data.selected))
  .sort(byRecency)
  .slice(0, 5);
const recentNotes = (await getNotes()).slice(0, 4);
---

<Base>
  <section class="intro">
    {site.photo && <img class="photo" src={site.photo} alt={`Photo of ${site.name}`} width="160" height="160" />}
    <div>
      <h1>{site.name}</h1>
      <p class="role">{site.title}<br />{site.affiliation}</p>
      <div class="link-row">
        <a href={`mailto:${site.email}`}>Email</a>
        <a href="/cv/">CV</a>
        {site.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </div>
  </section>

  {site.bio.map((p) => <p>{p}</p>)}

  <h2 class="section-title">Research interests</h2>
  <ul class="pill-row">{site.interests.map((i) => <li class="pill">{i}</li>)}</ul>

  {selected.length > 0 && (
    <>
      <h2 class="section-title">Selected publications</h2>
      <ul class="plain-list">{selected.map((pub) => <Publication pub={pub} />)}</ul>
      <p class="sans small"><a href="/publications/">All publications →</a></p>
    </>
  )}

  {recentNotes.length > 0 && (
    <>
      <h2 class="section-title">Recently in the wiki</h2>
      <NoteList notes={recentNotes} />
      <p class="sans small"><a href="/wiki/">Browse the wiki →</a></p>
    </>
  )}
</Base>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
    margin: 3rem 0 1.5rem;
  }
  .photo { width: 160px; height: 160px; object-fit: cover; border-radius: 50%; }
  .intro h1 { margin-bottom: 0.25rem; }
  .role { margin: 0 0 0.6rem; color: var(--muted); }
</style>
